# Veritabanı ve mesajlaşma
DB_URL=jdbc:postgresql://localhost:5432/agenticai
DB_USERNAME=postgres
DB_PASSWORD=dev
RABBITMQ_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Google Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CREDENTIALS=file:./secrets/google-service-account.json

# WhatsApp Cloud API - gerçek değerleri yalnızca yerel .env dosyasına yazın
WHATSAPP_CLOUD_API_ENABLED=false
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
WHATSAPP_STORE_MAPPINGS=phone-number-id=store-uuid
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_GRAPH_API_VERSION=v25.0

# LiveKit
LIVEKIT_ENABLED=false
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me
LIVEKIT_AGENT_DISPATCH_ENABLED=false
LIVEKIT_AGENT_NAME=

# Gateway güvenliği
JWT_ENABLED=false
JWT_SECRET=replace-with-at-least-32-characters
